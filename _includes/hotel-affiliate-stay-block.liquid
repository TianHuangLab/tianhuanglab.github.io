{% assign stay_limit = include.limit | default: 3 | plus: 0 %}

{% assign show_apartment = true %}
{% if include.apartment == false or include.apartment == "false" %}
{% assign show_apartment = false %}
{% endif %}

<div class="hotel-affiliate-stay-block">

{% include hotel-affiliate-hotel-grid.liquid
   area_id=include.area_id
   hotel_ids=include.hotel_ids
   placement=include.placement
   platform="trip"
   limit=stay_limit
   col=include.col
   button=include.button
   show_caution=include.show_caution
%}

{% include hotel-affiliate-area-links.liquid
   area_id=include.area_id
   city=include.city
   placement=include.placement
   apartment=show_apartment
   show_compare=include.show_compare
%}

</div>