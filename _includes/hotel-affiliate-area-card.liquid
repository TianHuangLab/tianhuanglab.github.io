{% if include.area_id %}
  {% assign area = site.data.hotel_areas[include.area_id] %}
{% endif %}

{% if area and area.status == "active" %}
  {% assign title = include.title | default: area.display_name %}
  {% assign text = include.text | default: area.description %}
  {% assign href = include.href | default: area.guide_url %}
  {% assign button = include.button | default: area.guide_button | default: "查看住宿攻略" %}

  <div class="col-12 col-md-4 mb-4">
    <div class="card h-100">
      <div class="card-body">

        <h3 class="h5 card-title mb-1">
          {{ title }}
        </h3>

        {% if area.local_name %}
          <p class="small text-muted mb-2">{{ area.local_name }}</p>
        {% endif %}

        {% if text %}
          <p class="card-text">{{ text }}</p>
        {% endif %}

        {% if area.best_for %}
          <ul class="small pl-3 mb-3">
            {% for item in area.best_for limit: 2 %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if area.caution %}
          <p class="small text-muted mb-3">
            <strong>注意：</strong>{{ area.caution }}
          </p>
        {% endif %}

        {% if href %}
          <a href="{{ href | relative_url }}" class="btn btn-sm btn-outline-primary">
            {{ button }}
          </a>
        {% endif %}

      </div>
    </div>
  </div>
{% endif %}