{% assign hotel_ids_raw = include.hotel_ids | default: "" %}
{% assign hotel_ids = hotel_ids_raw | split: "," %}

{% assign limit_count = include.limit | default: 4 | plus: 0 %}
{% if limit_count > 4 %}
  {% assign limit_count = 4 %}
{% endif %}

{% assign carousel_label = include.title | default: "酒店推荐" %}

{% if hotel_ids_raw != "" %}

  <div class="hotel-affiliate-carousel">

    {% if include.title or include.intro %}
      <div class="hotel-affiliate-carousel__header">

        {% if include.title %}
          <h3>{{ include.title }}</h3>
        {% endif %}

        {% if include.intro %}
          <p>{{ include.intro }}</p>
        {% endif %}

      </div>
    {% endif %}

    <div
      class="hotel-affiliate-carousel__rail"
      aria-label="{{ carousel_label | escape }}"
    >

      {% assign rendered = 0 %}

      {% for raw_id in hotel_ids %}

        {% if rendered >= limit_count %}
          {% break %}
        {% endif %}

        {% assign id = raw_id | strip %}
        {% assign hotel = site.data.hotels | where: "id", id | first %}

        {% if hotel and hotel.status == "active" %}
          <div class="hotel-affiliate-carousel__item">
            {% include hotel-affiliate-hotel-card.liquid hotel=hotel platform=include.platform placement=include.placement button=include.button show_caution=include.show_caution %}
          </div>
          {% assign rendered = rendered | plus: 1 %}
        {% endif %}

      {% endfor %}

    </div>

  </div>

{% endif %}