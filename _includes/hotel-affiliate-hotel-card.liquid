{% assign hotel = include.hotel %}

{% if hotel and hotel.status == "active" %}

  {% assign selected_platform = include.platform | default: hotel.preferred_platform | default: "trip" %}
  {% assign hotel_url = "" %}

  {% if hotel.affiliate_urls %}
    {% assign hotel_url = hotel.affiliate_urls[selected_platform] %}

    {% if hotel_url == blank and hotel.affiliate_urls.trip %}
      {% assign selected_platform = "trip" %}
      {% assign hotel_url = hotel.affiliate_urls.trip %}
    {% elsif hotel_url == blank and hotel.affiliate_urls.hotels %}
      {% assign selected_platform = "hotels" %}
      {% assign hotel_url = hotel.affiliate_urls.hotels %}
    {% elsif hotel_url == blank and hotel.affiliate_urls.booking %}
      {% assign selected_platform = "booking" %}
      {% assign hotel_url = hotel.affiliate_urls.booking %}
    {% endif %}
  {% endif %}

  {% if hotel_url != blank %}

    {% assign platform_data = site.data.hotel_affiliate_platforms[selected_platform] %}
    {% assign platform_name = platform_data.name | default: selected_platform %}
    {% assign link_rel = platform_data.rel | default: "sponsored nofollow noopener" %}
    {% assign button = include.button | default: "查看实时房价" %}
    {% assign placement = include.placement | default: "unspecified" %}
    {% assign hotel_alt = hotel.image_alt | default: hotel.hotel_name %}

    <article
      class="hotel-affiliate-card"
      data-hotel-affiliate-card
      data-hotel-id="{{ hotel.id | escape }}"
      data-hotel-name="{{ hotel.hotel_name | escape }}"
      data-hotel-platform="{{ selected_platform | escape }}"
      data-hotel-placement="{{ placement | escape }}"
      data-page-path="{{ page.url | escape }}"
    >

      {% if hotel.image %}
        <a
          class="hotel-affiliate-card__image"
          href="{{ hotel_url }}"
          target="_blank"
          rel="{{ link_rel }}"
          data-hotel-affiliate-link
          data-hotel-id="{{ hotel.id | escape }}"
          data-hotel-name="{{ hotel.hotel_name | escape }}"
          data-hotel-platform="{{ selected_platform | escape }}"
          data-hotel-placement="{{ placement | escape }}"
          data-page-path="{{ page.url | escape }}"
          aria-label="查看 {{ hotel.hotel_name | escape }} 实时房价"
        >
          <img
            src="{{ hotel.image | relative_url }}"
            alt="{{ hotel_alt | escape }}"
            loading="lazy"
          >
        </a>
      {% endif %}

      <div class="hotel-affiliate-card__body">

        <div class="hotel-affiliate-card__meta">
          {% if hotel.area %}
            <span>{{ hotel.area }}</span>
          {% endif %}
          {% if hotel.category %}
            <span>{{ hotel.category }}</span>
          {% endif %}
        </div>

        <p class="hotel-affiliate-card__title">
          {{ hotel.hotel_name }}
        </p>

        {% if hotel.recommendation_reason %}
          <p>{{ hotel.recommendation_reason }}</p>
        {% endif %}

        {% if include.show_caution == true or include.show_caution == "true" %}
          {% if hotel.caution_note %}
            <p class="hotel-affiliate-card__caution">
              <strong>订房前注意：</strong>{{ hotel.caution_note }}
            </p>
          {% endif %}
        {% endif %}

        <a
          class="hotel-affiliate-card__button"
          href="{{ hotel_url }}"
          target="_blank"
          rel="{{ link_rel }}"
          data-hotel-affiliate-link
          data-hotel-id="{{ hotel.id | escape }}"
          data-hotel-name="{{ hotel.hotel_name | escape }}"
          data-hotel-platform="{{ selected_platform | escape }}"
          data-hotel-placement="{{ placement | escape }}"
          data-page-path="{{ page.url | escape }}"
          aria-label="{{ button }}：{{ hotel.hotel_name | escape }}，{{ platform_name | escape }}"
        >
          {{ button }}
        </a>

      </div>
    </article>

  {% endif %}
{% endif %}